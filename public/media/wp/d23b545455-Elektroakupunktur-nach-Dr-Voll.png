<script>
(function () {
  var SLOGAN = /^(Sanft\s*Heilen)(\s*[–\-—]\s*Stark im Leben!?)?$/i;
  function textOf(el) {
    return (el.textContent || '').replace(/\s+/g, ' ').trim();
  }
  function hideSlogans() {
    document.querySelectorAll('h1, h2, h3, p, .el-title, .uk-panel, .uk-slideshow .uk-overlay, .uk-slideshow .el-content').forEach(function (el) {
      if (el.closest('#eeat-disclaimer-author, #eeat-cluster, footer, .tm-footer, #eeat-local-bar')) return;
      if (el.classList && el.classList.contains('eeat-slogan')) return;
      var t = textOf(el);
      if (SLOGAN.test(t) || /^Sanft\s*heilen\.?$/i.test(t)) {
        el.setAttribute('hidden', '');
        el.style.display = 'none';
      }
    });
  }
  function hideEmptyHeadings() {
    document.querySelectorAll('h1, h2, h3, h4').forEach(function (h) {
      if (!textOf(h)) {
        h.setAttribute('hidden', '');
        h.style.display = 'none';
      }
    });
  }
  function demoteTinyHeadings() {
    document.querySelectorAll('h2, h3').forEach(function (h) {
      if (h.closest('.uk-slideshow, #eeat-disclaimer-author, #eeat-cluster')) return;
      var fs = parseFloat(window.getComputedStyle(h).fontSize);
      if (!(fs < 14) || !textOf(h)) return;
      var p = document.createElement('p');
      p.className = h.className;
      p.innerHTML = h.innerHTML;
      h.parentNode.replaceChild(p, h);
    });
  }
  function nlsLayerCopy() {
    if (!/\/nls-diagnostik\/?$/.test(location.pathname)) return;
    var first = document.querySelector('.uk-slideshow-items > *');
    if (first) {
      var meta = first.querySelector('.el-meta');
      var title = first.querySelector('.el-title');
      if (meta) meta.textContent = 'NLS – Diagnostik';
      if (title) title.textContent = 'Metatron Hospital';
    }
    document.querySelectorAll('h2').forEach(function (h) {
      if (h.closest('.uk-slideshow')) return;
      var t = (h.textContent || '').replace(/\s+/g, ' ').trim();
      if (/^mit der NLS-Diagnostik$/i.test(t)) {
        h.textContent = 'mit dem Metatron Hospital System';
      }
    });
  }
  function cleanAttrs() {
    document.querySelectorAll('img').forEach(function (img) {
      ['alt', 'title'].forEach(function (attr) {
        var v = img.getAttribute(attr);
        if (!v) return;
        var n = v
          .replace(/Sanft\s*Heilen(\s*Stark im Leben)?/gi, '')
          .replace(/Bioresonanz versus Elektroakupunktur/gi, 'Bioresonanz und Elektroakupunktur')
          .replace(/\s*[-–]\s*$/g, '')
          .replace(/^\s*[-–]\s*/g, '')
          .replace(/\s{2,}/g, ' ')
          .trim();
        if (n !== v) img.setAttribute(attr, n);
      });
    });
  }
  function cleanJsonLd() {
    document.querySelectorAll('script.rank-math-schema, script[type="application/ld+json"]').forEach(function (s) {
      var t = s.textContent || '';
      if (!/loszuwerden|sanfte,? ganzheitliche Medizin/i.test(t)) return;
      s.textContent = t
        .replace(/Der neue Weg um damit verbundene Krankheitsbeschwerden loszuwerden/g, '')
        .replace(/sanfte,? ganzheitliche Medizin/gi, '');
    });
  }
  function run() {
    hideSlogans();
    hideEmptyHeadings();
    demoteTinyHeadings();
    nlsLayerCopy();
    cleanAttrs();
    cleanJsonLd();
  }
  run();
  document.addEventListener('DOMContentLoaded', run);
  window.addEventListener('load', run);
  setTimeout(run, 400);
  setTimeout(run, 1500);
  setTimeout(run, 2800);
})();
</script>

